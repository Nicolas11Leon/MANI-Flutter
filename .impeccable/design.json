  "narrative": {
    "northStar": "La ficha sellada",
    "overview": "Every surface in MANI reads like a printed, stamped work card: a white card with a firm charcoal outline, sitting on a warm paper ground, casting a hard shadow as if it had been pressed onto the desk. The brand color is the stamp. It marks what matters right now and nothing else.",
    "keyCharacteristics": [
      "Charcoal 2px outlines on every container and control; the outline, not the fill, separates surfaces.",
      "Hard offset shadows with no blur; they collapse when a control is pressed.",
      "One stamp color (#F8DE7E) used for state and primary action, always with its outline.",
      "Plus Jakarta Sans in heavy weights for titles and labels; medium for reading text.",
      "One top bar for the whole app (logo, menu entries, account); each screen opens with its own heading in the content."
    ],
    "rules": [
      {
        "name": "The Stamp Needs Ink Rule",
        "body": "Stamp Butter against the paper ground is only 1.3:1, so a brand fill always carries the charcoal outline.",
        "section": "colors"
      },
      {
        "name": "The Stamp Is Not Text Rule",
        "body": "Stamp Butter is a fill, never a text color; secondary text on it is On-Brand Muted.",
        "section": "colors"
      },
      {
        "name": "The Red Means Loss Rule",
        "body": "Danger red is reserved for destructive or failed outcomes.",
        "section": "colors"
      },
      {
        "name": "The Weight Before Size Rule",
        "body": "Hierarchy steps by weight first and size second; every size comes from the scale.",
        "section": "typography"
      },
      {
        "name": "The Press Collapses Rule",
        "body": "A pressed control loses its shadow and moves by the offset, as a transform.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do give every brand fill its 2px charcoal outline.",
      "Do start every in-app screen with the shared screen heading, aligned to the content width token; never add a second top bar.",
      "Do express state through ManiTono and the status badge, with an icon.",
      "Do keep every value on the token scales."
    ],
    "donts": [
      "Don't use Stamp Butter as a text color or rely on it without an outline.",
      "Don't use red for a non-destructive action.",
      "Don't add soft, blurred shadows or tonal elevation.",
      "Don't let fields or cards stretch to the full desktop width.",
      "Don't invent customer metrics, testimonials or logos in any surface."
    ]
  }
}
